.venv/
.pytest_cache/
__pycache__/
*.pyc
inverserg.egg-info/
artifacts/
.claude/settings.local.json

# heavy regenerable SU(2) artifacts (reports/figures stay tracked)
out/su2_2d/data/
out/su2_2d/checkpoints/

# Heavy regenerable artifacts (untracked 2026-08-20, ~650 MB).
# Ensembles and optimizer state are outputs of a stage and are regenerated by
# re-running it; only the trained model checkpoints are of record. The negation
# keeps out/<theory>/checkpoints/*.pt tracked -- note it is one level deep, so
# out/u2_2d/smoke/checkpoints/ stays ignored, which is intended.
out/**/*.pt
!out/*/checkpoints/*.pt
out/**/*.pt.resume

# Live run logs -- process output, appended to while stages run. Tracking them
# means a dirty tree at unpredictable moments and open file handles during any
# history operation. u1_2d logs stay tracked; that study is closed.
out/u2_2d/logs/
out/u2_2d/keep_awake.log

# Overleaf export bundle -- 14 MB of figures duplicated out of both studies'
# paper_appendix/figures/, regenerated in seconds by
# u1_2d/scripts/64_export_paper_bundle.py. The appendix directories themselves
# ARE tracked; this is the copy made for upload.
paper/
